# ==============================================
# CUSC CRM - Environment Configuration
# ==============================================
# Copy file này thành .env và điền các giá trị phù hợp
# KHÔNG BAO GIỜ commit file .env lên git repository
# ==============================================

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DB_SERVER=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=cusc_db
DB_TYPE=mysqli

# ==============================================
# SITE CONFIGURATION
# ==============================================
SITE_URL=http://localhost/cusc/
ROOT_DIRECTORY=C:\xampp\htdocs\cusc/

# ==============================================
# SECURITY KEYS (QUAN TRỌNG - Tạo key mới cho production)
# ==============================================
# Application Unique Key - Tạo key ngẫu nhiên 32 ký tự
APPLICATION_UNIQUE_KEY=your_unique_application_key_here

# CSRF Secret - Tạo key ngẫu nhiên 40 ký tự
CSRF_SECRET=your_csrf_secret_key_here

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
HELPDESK_SUPPORT_EMAIL=support@example.com
HELPDESK_SUPPORT_NAME=CUSC Support

# ==============================================
# DEFAULT USER SETTINGS
# ==============================================
# Thông tin hiển thị mặc định trên form đăng nhập (để trống cho production)
DEFAULT_USER_NAME=
DEFAULT_PASSWORD=

# ==============================================
# GMAIL IMAP PROXY (nếu sử dụng)
# ==============================================
GMAIL_IMAP_HOST=localhost
GMAIL_IMAP_PORT=993
GMAIL_IMAP_SSL=true

# ==============================================
# TIMEZONE
# ==============================================
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# ==============================================
# DEBUG MODE (đặt false cho production)
# ==============================================
DEBUG_MODE=false

# ==============================================
# BRANDING & LOGIN PAGE CUSTOMIZATION
# ==============================================
# App name hiển thị trên trang login
APP_NAME=CUSC CRM

# Tagline/slogan hiển thị bên dưới logo
APP_TAGLINE=Hệ thống Quản lý Quan hệ Khách hàng

# Logo trên trang login (đường dẫn tương đối từ root)
# Hỗ trợ: PNG, JPG, SVG
APP_LOGO=layouts/v7/resources/Images/cusc-logo.svg

# Background trang login (đường dẫn tương đối từ root)
# Khuyến nghị: 1920x1080px hoặc lớn hơn
LOGIN_BACKGROUND=layouts/v7/resources/Images/login-background.jpg

# Footer copyright
APP_COPYRIGHT=© 2025 Your Company Name. All Rights Reserved.
APP_WEBSITE=https://yourwebsite.com

# Marketing panel (bên phải trang login)
SHOW_MARKETING_PANEL=true
MARKETING_TITLE=Chào mừng đến với CRM
MARKETING_DESCRIPTION=Giải pháp quản lý khách hàng toàn diện cho doanh nghiệp của bạn
MARKETING_FEATURES=Quản lý leads & contacts|Tích hợp email|Báo cáo & phân tích|Workflow tự động

