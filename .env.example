# ==============================================
# CUSC CRM - Environment Configuration
# ==============================================
# Copy file này thành .env và điền các giá trị phù hợp
# KHÔNG BAO GIỜ commit file .env lên git repository
# ==============================================

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DB_SERVER=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=crm
DB_TYPE=mysqli

# ==============================================
# SITE CONFIGURATION
# ==============================================
SITE_URL=http://localhost/HTQL-Khach-Hang-CRM
ROOT_DIRECTORY="C:\xampp\htdocs\cusc"

# ==============================================
# SECURITY KEYS
# ==============================================
APPLICATION_UNIQUE_KEY=your_unique_application_key_here
CSRF_SECRET=your_csrf_secret_key_here

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
HELPDESK_SUPPORT_EMAIL=support@example.com
HELPDESK_SUPPORT_NAME=CUSC Support

# ==============================================
# GMAIL IMAP PROXY
# ==============================================
GMAIL_IMAP_HOST=localhost
GMAIL_IMAP_PORT=993
GMAIL_IMAP_SSL=true

# ==============================================
# TIMEZONE (DISPLAY)
# ==============================================
# Timezone used for custom display logic. Core vtiger DB timezone remains UTC.
# Use IANA name format to avoid ambiguity.
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# ==============================================
# SESSION & ACTIVITY TRACKING
# ==============================================
# Thời gian (giây) không hoạt động trước khi cron đánh dấu session 'expired'
SESSION_INACTIVITY_TIMEOUT=900

# PHP session.gc_maxlifetime (giây) - thời gian tối đa PHP giữ session file
SESSION_GC_MAXLIFETIME=1440

# Khoảng thời gian (giây) giữa các heartbeat từ browser lên server
HEARTBEAT_INTERVAL=300

# Thời gian (giây) không thao tác trên browser thì tự động sign off
CLIENT_INACTIVITY_LIMIT=900

# ==============================================
# DEBUG MODE
# ==============================================
DEBUG_MODE=False

# ==============================================
# BRANDING & LOGIN PAGE CUSTOMIZATION
# ==============================================
APP_NAME=CUSC CRM
APP_TAGLINE=Hệ thống Quản lý Quan hệ Khách hàng
APP_LOGO=test/upload/images/Logo_CUSC.png
LOGIN_BACKGROUND=layouts/v7/resources/Images/login-background.jpg
APP_COPYRIGHT=© 2025 CUSC - Trung tâm Công nghệ Phần mềm, Đại học Cần Thơ
APP_WEBSITE=https://cusc.ctu.edu.vn
SHOW_MARKETING_PANEL=true
MARKETING_TITLE=Chào mừng đến với CUSC CRM
MARKETING_DESCRIPTION=Giải pháp quản lý khách hàng toàn diện cho doanh nghiệp của bạn
MARKETING_FEATURES=Quản lý leads & contacts|Tích hợp email|Báo cáo & phân tích|Workflow tự động
